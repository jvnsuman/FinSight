# Copy this file to backend/.env and fill in real values for local dev.
# See backend/config.py for the full Settings class this maps to -
# every field there has a name-matching env var here.
#
# In production (Render), none of this comes from a .env file - these
# same variable names are set directly as environment variables on the
# service (see render.yaml's envVars and the README's Deployment section).

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_analytics_platform

# --- Auth / JWT ---
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string
ALGORITHM=HS256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Email ---
# Sent via Brevo's transactional email HTTP API (api.brevo.com), not raw
# SMTP - Render's free tier blocks outbound SMTP ports entirely (25, 465,
# 587), so smtplib never works there even with correct Gmail credentials.
# Sign up free at brevo.com (300 emails/day, no domain verification
# needed to start), then grab your key from SMTP & API -> API Keys.
BREVO_API_KEY=your-brevo-api-key
SMTP_FROM_EMAIL=your-address@gmail.com
SMTP_FROM_NAME=Finance Analytics Platform

# SMTP_HOST/SMTP_SERVER/SMTP_PORT/SMTP_USERNAME/SMTP_PASSWORD are no
# longer used by the app (kept in config.py for reference only) - safe
# to leave unset.

# --- AI (Gemini) ---
GEMINI_API_KEY=your-gemini-api-key

# --- App ---
APP_NAME=Finance Analytics Platform
DEBUG=true
FRONTEND_URL=http://localhost:5173

# --- Market data ---
MARKET_DATA_CACHE_TTL_MINUTES=15

# --- Finvu integration (only needed if you're working on that feature) ---
FINVU_PRIVATE_KEY_PATH=backend/secrets/finvu_private_key.pem
FINVU_PUBLIC_JWK_PATH=backend/secrets/finvu_public_key.jwk.json
