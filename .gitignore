# Sensitive configuration & secrets
# backend/config.py is intentionally NOT listed here anymore - it's a
# pydantic-settings class with safe defaults, not a file of real secret
# values (those come from a local .env or the deploy platform's env vars).
# It was gitignored for a long time under the assumption it held secrets
# directly, which meant it was silently missing from every fresh deploy
# (see the file's own docstring for the incident this caused).
.env
.env.*
!.env.example
backend/secrets/
**/secrets/

# Python virtual environment
.venv/
venv/
env/
ENV/

# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Pytest cache (local test-run artifacts, not source)
.pytest_cache/
backend/.pytest_cache/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Alembic (keep migrations, ignore local db if any)
*.sqlite3
*.db

# Node / frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Logs
*.log
npm-debug.log*

# VS Code / editor settings
.vscode/
.idea/

# OS-specific files
.DS_Store
Thumbs.db

# Jupyter Notebook checkpoints
.ipynb_checkpoints
