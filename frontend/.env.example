# Copy this file to .env and fill in the value for your environment.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Base URL of the FastAPI backend.
# Local dev (matches backend/main.py's default uvicorn port): http://127.0.0.1:8000
# Production: the backend's Render URL, e.g. https://finsight-backend.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000
